{
  "schemaVersion": 1,
  "id": "spoiledz",
  "version": "${version}",
  "name": "SpoiledZ",
  "description": "Adds season spoilage to food items",
  "authors": [
    "Globox_Z",
    "SpigotDE"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/minecraft/mc-mods/spoiledz",
    "sources": "https://github.com/Globox1997/SpoiledZ",
    "issues": "https://github.com/Globox1997/SpoiledZ/issues"
  },
  "license": "MIT",
  "icon": "assets/spoiledz/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.spoiledz.SpoiledZMain"
    ],
    "client": [
      "net.spoiledz.SpoiledZClient"
    ],
    "modmenu": [
      "net.spoiledz.config.ModMenuIntegration"
    ],
    "appleskin": [
      "net.spoiledz.compat.AppleSkinPlugin"
    ]
  },
  "mixins": [
    "spoiledz.mixins.json"
  ],
  "depends": {
    "java": ">=21",
    "minecraft": ">=${minecraft_version}",
    "fabric-api": ">=${fabric_version}",
    "fabricloader": ">=${loader_version}",
    "cloth-config2": ">=${cloth_config_version}"
  },
  "suggests": {
    "another-mod": "*"
  },
  "custom": {
    "mc-publish": {
      "modrinth": "WBzldFmc",
      "curseforge": 834671
    }
  }
}